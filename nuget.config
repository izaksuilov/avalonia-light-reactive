<?xml version="1.0" encoding="utf-8"?>
<!-- Package sources. Machine-wide and user feeds are disabled so that the set of packages
     does not depend on the build machine. Only nuget.org is needed: Avalonia, Roslyn and xunit. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
